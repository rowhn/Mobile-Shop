# Leave empty in local development: Vite proxies /api to http://localhost:5000.
# In production (Vercel) set this to your deployed backend, including /api. Example:
#   VITE_API_URL=https://nova-api.onrender.com/api
VITE_API_URL=

# Only used by `npm run dev` to change the proxy target.
# VITE_DEV_API=http://localhost:5000
