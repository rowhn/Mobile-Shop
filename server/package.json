    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.6",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "razorpay": "^2.9.8",
    "zod": "^3.25.76"
  }
}
